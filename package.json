{
  "name": "azurian-playwright-bdd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && cucumber-js",
    "test:api": "npm test -- --tags @api",
    "test:ui": "npm test -- --tags @ui",
    "test:crear": "npm test -- --tags @crear",
    "test:leer": "npm test -- --tags @leer",
    "test:editar": "npm test -- --tags @editar",
    "test:eliminar": "npm test -- --tags @eliminar",
    "test:dry": "npm run build && cucumber-js --dry-run",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "clean": "node -e \"for(const p of ['dist','allure-results','allure-report','test-results']) require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "@playwright/test": "^1.56.0",
    "allure-cucumberjs": "^3.0.0",
    "allure-commandline": "^2.34.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
